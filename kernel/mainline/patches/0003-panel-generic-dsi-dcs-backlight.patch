diff --git a/drivers/gpu/drm/panel/panel-generic-dsi.c b/drivers/gpu/drm/panel/panel-generic-dsi.c
--- a/drivers/gpu/drm/panel/panel-generic-dsi.c
+++ b/drivers/gpu/drm/panel/panel-generic-dsi.c
@@ -10,6 +10,7 @@
  * Copyright (C) Purism SPC 2019
  */
 
+#include <linux/backlight.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/hex.h>
@@ -713,6 +713,20 @@ static const struct drm_panel_funcs generic_panel_funcs = {
     .get_orientation = generic_panel_get_orientation,
 };
 
+static int generic_panel_bl_update_status(struct backlight_device *bl)
+{
+    struct generic_panel *ctx = bl_get_data(bl);
+    struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
+
+    return mipi_dsi_dcs_set_display_brightness_large(dsi,
+                    backlight_get_brightness(bl));
+}
+
+static const struct backlight_ops generic_panel_bl_ops = {
+    .options = BL_CORE_SUSPENDRESUME,
+    .update_status = generic_panel_bl_update_status,
+};
+
 static int generic_panel_probe(struct mipi_dsi_device *dsi)
 {
     struct device *dev = &dsi->dev;
@@ -792,6 +806,24 @@ static int generic_panel_probe(struct mipi_dsi_device *dsi)
     if (ret)
         return ret;
 
+    if (!ctx->panel.backlight &&
+        of_property_read_bool(dev->of_node, "dcs-backlight")) {
+        const struct backlight_properties props = {
+            .type = BACKLIGHT_RAW,
+            .brightness = 2000,
+            .max_brightness = 4095,
+        };
+
+        ctx->panel.backlight = devm_backlight_device_register(dev,
+                    dev_name(dev), dev, ctx,
+                    &generic_panel_bl_ops, &props);
+        if (IS_ERR(ctx->panel.backlight)) {
+            ret = PTR_ERR(ctx->panel.backlight);
+            dev_err(dev, "failed to register DCS backlight: %d\n", ret);
+            return ret;
+        }
+    }
+
     drm_panel_add(&ctx->panel);
 
     ret = mipi_dsi_attach(dsi);
