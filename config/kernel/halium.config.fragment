# TB328FU Halium 12 minimum config delta.
# Merge only after identifying the exact Lenovo kernel source and defconfig.

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VT=y
CONFIG_SYSVIPC=y
CONFIG_FHANDLE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_MMC_SDHCI_SPRD=y
CONFIG_MMC_HSQ=y
CONFIG_MMC_SWCQ=y
# CONFIG_STATIC_USERMODEHELPER is not set

# Vendor scheduler code assumes module infrastructure exists. Keep it enabled,
# but do not package/load Lenovo modules against this incompatible donor ABI.
CONFIG_MODULES=y
# CONFIG_MODVERSIONS is not set

# LTO/CFI exceed available WSL build memory.
# CONFIG_LTO is not set
# CONFIG_LTO_CLANG is not set
CONFIG_LTO_NONE=y
# CONFIG_CFI_CLANG is not set
# CONFIG_CFI_CLANG_SHADOW is not set

# TB328FU uses Himax. This unrelated donor driver fails under Clang 12.
# CONFIG_TOUCHSCREEN_OMNIVISION_TCM is not set
# CONFIG_TOUCHSCREEN_OMNIVISION_TCM_I2C is not set
# CONFIG_TOUCHSCREEN_OMNIVISION_TCM_SPI is not set
# CONFIG_TOUCHSCREEN_OMNIVISION_TCM_CORE is not set

# AppArmor remains a source-level task. Do not enable these until the selected
# 5.4 tree contains the required Android/Ubuntu AppArmor implementation.
# CONFIG_SECURITY_APPARMOR=y
# CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
# CONFIG_DEFAULT_SECURITY_APPARMOR=y

